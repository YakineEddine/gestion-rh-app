# Configuration de la base de données PostgreSQL
# Remplacez avec vos propres identifiants locaux
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_rh_db

# Sécurité JWT
SECRET_KEY=votre_cle_secrete_jwt_securisee_tres_longue_et_aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Protection contre les attaques brute-force
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Robustesse des mots de passe
PASSWORD_MIN_LENGTH=8

# Configuration SMTP Gmail pour l'envoi d'emails (fallback)
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Créez un mot de passe d'application : https://myaccount.google.com/apppasswords
SMTP_EMAIL=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_google

# Service Email API (Resend ou Brevo recommandé)
# Providers : resend | brevo | smtp
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=votre_cle_api_email_resend_ou_brevo
EMAIL_FROM=votre_email@domaine.com
EMAIL_FROM_NAME=Enterprise RH

# URL de l'application frontend (pour les liens dans les emails)
APP_URL=http://localhost:5173

# Service IA (Gemini, OpenAI ou Grok/xAI)
# Providers : gemini | openai | grok
AI_PROVIDER=gemini
AI_API_KEY=votre_cle_api_ia_gemini_ou_grok
AI_MODEL=gemini-3.7-flash
AI_BASE_URL=

# Google reCAPTCHA v2 (Clés de test officielles Google pour dev/test)
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI